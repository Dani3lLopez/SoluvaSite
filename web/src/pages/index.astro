---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { TextReveal } from '../components/arc/text-reveal/text-reveal';
import { company, services, sectors, brands, clients, process, values, whatsappUrl, mapUrl } from '../data/company';
---
<Layout>
  <Header />
  <main id="contenido">
    <section class="hero container" id="inicio" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="red-dot"></span> SEGURIDAD ELECTRÓNICA · EL SALVADOR</p>
        <TextReveal as="h1" id="hero-heading" text={'Seguridad electrónica.\nTecnología que conecta.'} />
        <p class="hero-description">{company.introduction}</p>
        <div class="hero-actions">
          <a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Solicitar cotización <Icon name="arrow" size={18} /></a>
          <a class="text-link" href="#servicios">Explorar soluciones <Icon name="chevron" size={16} /></a>
        </div>
        <div class="hero-footnote">
          <span class="footnote-rule"></span>
          <p>Desde 2015 en El Salvador.<br /><strong>De la planificación a la puesta en marcha.</strong></p>
        </div>
      </div>
      <figure class="hero-visual">
        <img src="/images/seguridad-ilustrativa.webp" width="1122" height="1402" alt="Imagen ilustrativa de una cámara de videovigilancia en una fachada moderna" fetchpriority="high" />
        <figcaption><span>01 / VIDEOVIGILANCIA</span><span>SOLUVA <Icon name="arrow" size={14} /></span></figcaption>
      </figure>
    </section>

    <div class="sector-strip">
      <div class="container sector-inner">
        <p>Soluciones para <br /><strong>cada entorno.</strong></p>
        <ul aria-label="Sectores atendidos">{sectors.map((sector) => <li>{sector}</li>)}</ul>
      </div>
    </div>

    <section class="section container solutions" id="servicios" aria-labelledby="services-heading">
      <div class="section-intro" data-reveal>
        <div>
          <p class="eyebrow">01 / NUESTRAS SOLUCIONES</p>
          <h2 id="services-heading">Seguridad y tecnología.<br />Todas sus soluciones.</h2>
        </div>
        <p>Distribución de equipos y accesorios, instalación y soporte. Integramos cada sistema según las necesidades técnicas de su proyecto.</p>
      </div>
      <div class="service-list">
        {services.map((service, index) => (
          <details class="service" id={service.id} open={index === 0}>
            <summary>
              <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="service-icon"><Icon name={service.icon} /></span>
              <h3>{service.name}</h3>
              <span class="service-plus" aria-hidden="true"></span>
            </summary>
            <div class="service-body">
              <p>{service.description}</p>
              <div class="service-tags">{service.tags.map((tag) => <span>{tag}</span>)}</div>
              <a class="text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Consultar esta solución <Icon name="arrow" size={16} /></a>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="about section" id="nosotros" aria-labelledby="about-heading">
      <div class="container about-grid">
        <div class="about-left" data-reveal>
          <p class="eyebrow">02 / SOBRE SOLUVA</p>
          <h2 id="about-heading">SOLUVA en El Salvador.<br />Atención cercana.</h2>
          <p class="about-lead">{company.about}</p>
          <p>Creemos en relaciones comerciales duraderas, construidas sobre el respeto, la responsabilidad y el cumplimiento de los compromisos adquiridos.</p>
          <div class="about-stamp"><span>2015</span><p>Año de fundación<br />San Salvador, El Salvador</p></div>
        </div>
        <div class="about-right" data-reveal data-reveal-delay="60">
          <details class="purpose" open>
            <summary>Nuestra misión <span aria-hidden="true">+</span></summary>
            <p>{company.mission}</p>
          </details>
          <details class="purpose">
            <summary>Nuestra visión <span aria-hidden="true">+</span></summary>
            <p>{company.vision}</p>
          </details>
          <h3 class="values-heading">Lo que guía nuestro trabajo</h3>
          <ul class="values-list">{values.map((value) => <li><Icon name="check" size={16} /><div><strong>{value.name}</strong><p>{value.description}</p></div></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="experience section" id="experiencia" aria-labelledby="experience-heading">
      <div class="container">
        <div class="section-intro" data-reveal>
          <div>
            <p class="eyebrow">03 / EXPERIENCIA & ACOMPAÑAMIENTO</p>
            <h2 id="experience-heading">A su lado, en cada<br />etapa del proyecto.</h2>
          </div>
          <p>Desde 2015 desarrollamos soluciones para empresas, instituciones y residencias. Combinamos experiencia técnica con atención personalizada.</p>
        </div>
        <ol class="process-list">{process.map((step, index) => (
          <li data-reveal data-reveal-delay={index * 45}><span class="step-number">0{index + 1}</span><h3>{step.name}</h3><p>{step.description}</p></li>
        ))}</ol>
        <div class="experience-note"><Icon name="check" size={20} /><p>Experiencia en proyectos que integran videovigilancia, control de acceso, redes, comunicaciones y protección contra incendios.</p></div>
      </div>
    </section>

    <section class="clients section container" id="clientes" aria-labelledby="clients-heading">
      <div class="section-intro" data-reveal>
        <div>
          <p class="eyebrow">CLIENTES DE SOLUVA</p>
          <h2 id="clients-heading">Empresas que han trabajado<br />con nosotros.</h2>
        </div>
        <p>Nos han confiado sus necesidades de seguridad y tecnología. Cada proyecto es una oportunidad para construir relaciones duraderas.</p>
      </div>
      <div class="client-grid">
        {clients.map((client) => <figure class="client-cell" aria-label={client.name}>
          <div class="client-logo-box"><img class:list={{ 'logo-image--light': client.light }} src={client.logo} width={client.width} height={client.height} alt="" loading="lazy" decoding="async" /></div>
          <figcaption aria-hidden="true">{client.name}</figcaption>
        </figure>)}
      </div>
    </section>

    <section class="brands section container" aria-labelledby="brands-heading">
      <div class="brands-heading" data-reveal>
        <p class="eyebrow">TECNOLOGÍA PARA CADA PROYECTO</p>
        <h2 id="brands-heading">Equipos de marcas reconocidas.</h2>
        <p>Integramos soluciones de acuerdo con los requerimientos técnicos de cada proyecto.</p>
      </div>
      <LogoMarquee items={brands} />
    </section>

    <section class="contact section" id="contacto" aria-labelledby="contact-heading">
      <div class="container contact-grid">
        <div data-reveal>
          <p class="eyebrow">04 / CONVERSEMOS</p>
          <h2 id="contact-heading">Conversemos sobre<br />su próximo proyecto.</h2>
          <p class="contact-lead">Le ayudamos a identificar la solución adecuada para las necesidades de seguridad y tecnología de su empresa.</p>
          <a class="button" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="chat" size={20} /> Escribir por WhatsApp <Icon name="arrow" size={18} /></a>
        </div>
        <dl class="contact-details" data-reveal data-reveal-delay="60">
          <div><dt><Icon name="phone" size={20} /> WhatsApp</dt><dd><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">{company.phone} <Icon name="arrow" size={16} /></a></dd></div>
          <div><dt><Icon name="mail" size={20} /> Correo electrónico</dt><dd><a href={'mailto:' + company.email}>{company.email} <Icon name="arrow" size={16} /></a></dd></div>
          <div><dt><Icon name="pin" size={20} /> Visítenos</dt><dd><a href={mapUrl} target="_blank" rel="noopener noreferrer">{company.address} <Icon name="arrow" size={16} /></a></dd></div>
          <div><dt><Icon name="clock" size={20} /> Horario de atención</dt><dd>{company.hours}</dd></div>
        </dl>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    import { initReveals } from '../lib/motion.mjs';
    initReveals();
  </script>
</Layout>

